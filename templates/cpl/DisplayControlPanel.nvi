			<else>
				<standard phase="stopCplServicePreVista" onError="ignore" when="install">
					<stopService name="${{serviceName}}" timeOut="40000"/>
				</standard>
			</else>
		</if>
		<if filter="minWin7">
			<custom phase="stopNvSmartMax" action="stopNvSmartMax" onError="ignore" when="install"/>
		</if>
		<if filter="minVista">
			<standard phase="deleteNvStartedOnInstall" onerror="ignore" when="always">
				<deleteFile target="${{NvidiaCommonAppData}}\NvStarted"/>
			</standard>
		</if>
		<standard phase="deletePersistenceVersion">
			<deleteRegistry keyName="${{NvidiaSoftwareKey}}\Global" valueName="PersistenceVersion"/>
		</standard>
		<standard phase="deleteNVFolderOn32Bit" onError="ignore" when="install" platform="x86">
			<deleteDirectoryTree target="${{SystemDirectory}}\NV"/>
		</standard>
		<standard phase="deleteNVFolderOn64Bit" onError="ignore" when="install" platform="amd64">
			<deleteDirectoryTree target="${{SystemDirectory}}\NV"/>
		</standard>
		<custom phase="checkOverInstallReboot" action="checkOverInstallReboot" when="install"/>
		<custom phase="decideCplFileList" action="decideCplFileList" when="install"/>
		<custom phase="decideDLLRegisterList" action="decideDLLRegisterList" when="install"/>
		<custom phase="decideRegisterNvXDSync" action="decideRegisterNvXDSync" when="install"/>
		<standard phase="cleanUpHistoricCPLFilesX86" platform="x86" onError="ignore" when="install">
			<deleteFile target="${{SystemDirectory}}\easyupdatusapiu.dll"/>
		</standard>
		<standard phase="cleanUpHistoricCPLFiles" onError="ignore" when="install">
			<deleteFile target="${{SystemDirectory}}\easyupdatusapiu64.dll"/>
			<deleteFile target="${{SystemDirectory}}\nvhotkey.dll"/>
		</standard>
		<standard phase="copyClientFiles" when="install">
