		</standard>
		<standard phase="createShellExtension" when="install">
			<addRegistry keyName="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\explorer\ControlPanel\NameSpace\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="" value="NVIDIA Control Panel" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="" value="NVIDIA Control Panel" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="InfoTip" value="@${{InstallLocation}}\nvcpluir.dll,-2211" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="LocalizedString" value="@${{InstallLocation}}\nvcpluir.dll,-2210" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="System.ApplicationName" value="NVIDIA.ControlPanel" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}" valueName="System.ControlPanel.Category" value="1,2" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}\DefaultIcon" valueName="" value="${{InstallLocation}}\nvcplui.exe,-128" valueType="REG_SZ"/>
			<addRegistry keyName="HKCR\CLSID\{0bbca823-e77d-419e-9a44-5adec2c8eeb0}\Shell\Open\Command" valueName="" value="${{InstallLocation}}\nvcplui.exe" valueType="REG_SZ"/>
		</standard>
		<if filter="minWin7">
			<standard phase="createPolicyKey" when="install">
				<addRegistry keyName="${{NvidiaSoftwareKey}}\Global\NvCplApi\Policies" valueName="CplGroupUIPolicy" value="0" valueType="REG_DWORD"/>
			</standard>
			<else>
				<standard phase="createDontLoad" when="install">
					<addRegistry keyName="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Control Panel\don't load" valueName="nvcpl.cpl" value="" valueType="REG_SZ"/>
				</standard>
			</else>
		</if>
		<standard phase="createPolicyKey" when="install">
			<addRegistry keyName="${{NvidiaSoftwareKey}}\NVControlPanel2" valueName="InstalledClient" value="${{InstallLocation}}\nvcplui.exe" valueType="REG_SZ"/>
			<addRegistry keyName="${{NvidiaSoftwareKey}}\NVControlPanel2" valueName="InstalledClientDll" value="${{NvidiaProgramFiles}}\Display\nvui.dll" valueType="REG_SZ"/>
			<addRegistry keyName="${{NvidiaSoftwareKey}}\NVControlPanel\RegisteredServers2" valueName="Dummy" value="{00000000-0000-0000-0000-000000000001}" valueType="REG_SZ"/>
			<addRegistry keyName="${{NvidiaSoftwareKey}}\Global\NVTweak" valueName="InstalledDisplayServers" value="${{NvidiaProgramFiles}}\Display\" valueType="REG_SZ"/>
		</standard>
		<custom phase="createPersistenceGUID" action="createPersistenceGUID"/>
		<exe phase="registerNvXDSync" when="install" name="${{nvxdSyncDestinationPath}}" condition="registerNvXDSync">
			<arg value="/regServer"/>
		</exe>
		<exe phase="unRegisterNvXDSync" when="uninstall" name="${{nvxdSyncDestinationPath}}" condition="unRegisterNvXDSync" onError="ignore">
			<arg value="/unregserver"/>
		</exe>
		<custom phase="decideUnRegisterNvXDSync" action="decideUnRegisterNvXDSync" when="uninstall" onError="ignore"/>
		<standard phase="registerDLLs">
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvlicensings.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvsvs.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvmccss.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvdisps.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvgames.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvmobls.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvvitvs.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvwss.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvxdapix.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvxdbat.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvxdplcy.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvcplui.dll"/>
			<registerDll target="${{NvidiaProgramFiles}}\Display\nvui.dll"/>
			<registerDll target="${{SystemDirectory}}\nvsvc64.dll"/>
			<registerDll target="${{SystemDirectory}}\nvsvc.dll"/>
			<registerDll target="${{SystemDirectory}}\nvshext.dll"/>
			<registerDll target="${{SystemDirectory}}\nv3dappshext.dll"/>
			<if filter="XP">
				<registerDll target="${{SystemDirectory}}\nvcpl.dll"/>
			</if>
		</standard>
		<custom phase="createAddRegActions" action="createAddRegActions" when="install"/>
		<custom phase="checkForCplServiceBinary" action="checkForCplServiceBinary" when="install"/>
		<standard phase="createCplService" condition="serviceBinaryInstalled" when="install">
			<createService name="${{serviceName}}" type="16" target="${{SystemDirectory}}\${{cplServiceBinaryName}}" displayName="${{serviceDisplayName}}" description="${{serviceDescription}}" groupName="Video" startCode="2" errorControl="0" startNow="false"/>
		</standard>
		<standard phase="deleteCplService" onError="ignore" when="uninstall">
			<deleteService name="${{serviceName}}"/>
		</standard>
		<exe phase="registerServiceBinary" name="${{SystemDirectory}}\${{cplServiceBinaryName}}" condition="serviceBinaryInstalled" when="install">
			<arg value="-install"/>
		</exe>
		<exe phase="unRegisterServiceBinary" onError="ignore" name="${{SystemDirectory}}\${{cplServiceBinaryName}}" when="uninstall">
			<arg value="-uninstall"/>
		</exe>
		<if filter="minVista">
			<custom phase="decideCplServiceStart" action="decideCplServiceStart" when="install"/>
			<standard phase="startCplService" condition="startService" when="install">
				<startService name="${{serviceName}}" timeOut="40000"/>
			</standard>
		</if>
		<if filter="minVista">
			<custom phase="waitCplProcesses" action="waitForProcess" onError="ignore" when="uninstall">
				<properties>
					<string name="process" value="NvXDSync.exe"/>
					<int name="timeout" value="10000"/>
					<bool name="force" value="true"/>
				</properties>
			</custom>
			<standard phase="waitForCplServiceStop" onError="ignore" when="uninstall">
				<waitForService name="${{serviceName}}" state="1" timeOut="40000"/>
			</standard>
			<standard phase="stopCplServiceMinVista" onError="ignore" when="uninstall">
				<controlService name="${{serviceName}}" command="129"/>
			</standard>
			<else>
				<standard phase="stopCplServicePreVista" onError="ignore" when="uninstall">
					<stopService name="${{serviceName}}" timeOut="40000"/>
				</standard>
			</else>
		</if>
	</phases>
</nvi>
