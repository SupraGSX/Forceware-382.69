		<standard phase="setBetaFlag" when="install" condition="Beta">
			<addRegistry keyName="${{GFExperienceGlobalRegKey}}" valueName="Beta" type="REG_DWORD" value="1"/>
		</standard>
		<exe phase="ForceBetaSelfUpdates" name="${{GeForceExperienceX86Path}}\${{GFExperienceExeName}}" condition="Beta" when="install" progress="50" autoTick="500" onError="ignore">
			<arg value="-forceSelfUpdateBeta"/>
			<arg value="${{ValidClientLaunchFlag}}"/>
		</exe>
		<standard phase="clearBetaFlag" when="install" condition="!Beta">
			<deleteRegistry keyName="${{GFExperienceGlobalRegKey}}" valueName="Beta"/>
		</standard>
		<standard phase="SetNVUpdateInstalledValueToZero" when="install">
			<addRegistry keyName="${{NvidiaSoftwareKey}}\Global\nvUpdate" valueName="Installed" type="REG_DWORD" value="0"/>
