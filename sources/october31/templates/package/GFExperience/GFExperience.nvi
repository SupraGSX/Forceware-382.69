	<phases>
		<standard phase="createCrashDumpGenerationKeys">
			<addRegistry keyName="${{crashDumpKey}}\${{GFExperienceExeName}}"/>
			<addRegistry keyName="${{crashDumpKey}}\${{GFExperienceExeName}}" valueName="DumpFolder" type="REG_EXPAND_SZ" value="%PROGRAMDATA%\NVIDIA Corporation\CrashDumps"/>
			<addRegistry keyName="${{crashDumpKey}}\${{GFExperienceExeName}}" valueName="DumpCount" type="REG_DWORD" value="15"/>
			<addRegistry keyName="${{crashDumpKey}}\${{GFExperienceExeName}}" valueName="DumpType" type="REG_DWORD" value="1"/>
			<addRegistry keyName="${{crashDumpKey}}\${{LaunchGFExperienceExeName}}"/>
			<addRegistry keyName="${{crashDumpKey}}\${{LaunchGFExperienceExeName}}" valueName="DumpFolder" type="REG_EXPAND_SZ" value="%PROGRAMDATA%\NVIDIA Corporation\CrashDumps"/>
			<addRegistry keyName="${{crashDumpKey}}\${{LaunchGFExperienceExeName}}" valueName="DumpCount" type="REG_DWORD" value="15"/>
			<addRegistry keyName="${{crashDumpKey}}\${{LaunchGFExperienceExeName}}" valueName="DumpType" type="REG_DWORD" value="1"/>
			<addRegistry keyName="${{crashDumpKey}}\${{BackendProcessName}}"/>
			<addRegistry keyName="${{crashDumpKey}}\${{BackendProcessName}}" valueName="DumpFolder" type="REG_EXPAND_SZ" value="%PROGRAMDATA%\NVIDIA Corporation\CrashDumps"/>
			<addRegistry keyName="${{crashDumpKey}}\${{BackendProcessName}}" valueName="DumpCount" type="REG_DWORD" value="15"/>
			<addRegistry keyName="${{crashDumpKey}}\${{BackendProcessName}}" valueName="DumpType" type="REG_DWORD" value="1"/>
			<if filter="64BitPlatform">
				<addRegistry keyName="${{crashDumpKey}}\WLMerger.exe"/>
				<addRegistry keyName="${{crashDumpKey}}\WLMerger.exe" valueName="DumpFolder" type="REG_EXPAND_SZ" value="%PROGRAMDATA%\NVIDIA Corporation\CrashDumps"/>
				<addRegistry keyName="${{crashDumpKey}}\WLMerger.exe" valueName="DumpCount" type="REG_DWORD" value="15"/>
				<addRegistry keyName="${{crashDumpKey}}\WLMerger.exe" valueName="DumpType" type="REG_DWORD" value="1"/>
			</if>
		</standard>
		<standard phase="deleteJarvisStateFiles" when="uninstall">
			<deleteDirectoryTree target="${{LocalUserAppData}}\NVIDIA\NVGS"/>
		</standard>
		<custom phase="CloseSteam" action="CloseSteam" when="install" onError="ignore" progress="500" autoTick="200" condition="CloseSteam"/>
		<standard phase="DeleteOldStartMenuShortcut" when="install" onError="ignore">
			<deleteShortcutLink linkName="${{GFExperienceLinkName}}" location="startMenu" linkGroup="${{NVIDIAProgramGroup}}\${{title}}"/>
			<deleteShortcutGroup location="startMenu" linkGroup="${{NVIDIAProgramGroup}}\${{title}}"/>
		</standard>
		<exe phase="stopNvtmruInstances" name="${{NVIDIAUpdateCoreX86Path}}\NvTmru.exe" when="install" onError="ignore">
			<arg value="--shutdown"/>
			<success value="0"/>
		</exe>
		<custom phase="deleteGFExperienceEventSource" action="DeleteGFExperienceEventSource" when="install" onError="ignore">
			<properties>
				<string name="EventSourceName" value="${{GFExperienceEventSourceName}}"/>
			</properties>
		</custom>
		<custom phase="decidePreGalaxSettingsRemoval" action="DecidePreGalaxSettingsRemoval" when="install" onError="ignore"/>
		<standard phase="cleanupPreGalxSettings" when="install" condition="RemovePreGalaxSettings" onError="ignore">
			<deleteDirectoryTree target="${{LocalUserAppData}}\NVIDIA\${{GFExperienceExeName}}¤"/>
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\${{GeForceExperienceName}}\globalsettings.config"/>
		</standard>
		<custom phase="decideGFClientLogRemoval" action="decideGFClientLogRemoval" when="install" onError="ignore"/>
		<standard phase="cleanupGFClientLogFiles" when="install" condition="RemoveGFClientLogs" onError="ignore">
			<deleteFile target="${{CommonAppData}}\NVIDIA Corporation\${{GeForceExperienceName}}\Logs\GfeClientLog.log"/>
		</standard>
		<standard phase="cleanUpHistoricBinaries" onError="ignore" when="install">
			<deleteFile target="${{NVIDIAUpdateCoreX86Path}}\Oahu.dll"/>
			<deleteFile target="${{NVIDIAUpdateCoreX86Path}}\Oaremote_plugin.dll"/>
			<deleteFile target="${{NVIDIAUpdateCoreX86Path}}\NvTmru.exe"/>
