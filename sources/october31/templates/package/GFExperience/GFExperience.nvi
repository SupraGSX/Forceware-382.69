				<string name="LinkName" value="${{GFExperienceLinkName}}"/>
			</properties>
		</custom>
		<standard phase="modifyDesktopShortcutIfExists" when="install" condition="DesktopShortcutExists">
			<createShortcutLink location="desktop" targetPath="${{LaunchGFExperienceExeName}}" linkName="${{GFExperienceLinkName}}" startIn="${{GeForceExperienceX86Path}}" runAsAdmin="false"/>
		</standard>
		<standard phase="setShowEULAValueToOne" when="installClose" condition="Global:SkipEula">
			<addRegistry keyName="${{GFExperienceGlobalRegKey}}" valueName="ShowEULA" type="REG_DWORD" value="1"/>
		</standard>
		<standard phase="createDesktopShortcut" when="installClose" condition="CreateDesktopShortcut">
			<createShortcutLink location="desktop" targetPath="${{LaunchGFExperienceExeName}}" linkName="${{GFExperienceLinkName}}" startIn="${{GeForceExperienceX86Path}}" runAsAdmin="false"/>
		</standard>
		<custom phase="decideDeleteDesktopShortcut" action="DecideDeleteDesktopShortcut" when="installClose"/>
		<standard phase="deleteDesktopShortcut" when="installClose" condition="DeleteDesktopShortcut">
			<deleteShortcutLink location="desktop" targetPath="${{LaunchGFExperienceExeName}}" linkName="${{GFExperienceLinkName}}"/>
		</standard>
		<standard phase="deleteDesktopShortcut" when="uninstall">
			<deleteShortcutLink location="desktop" targetPath="${{LaunchGFExperienceExeName}}" linkName="${{GFExperienceLinkName}}"/>
		</standard>
		<exe phase="LaunchGFExperienceUserInstall" when="installClose" flags="noelevate" comment="LaunchGFExperienceUserInstall" name="${{InstallLocation}}\${{LaunchGFExperienceExeName}}" dir="${{InstallLocation}}" condition="!SelfUpdateInstall &amp;&amp; LaunchGFExperience"/>
		<exe phase="LaunchGFExperienceUpdateInstall" when="installClose" flags="noelevate" comment="LaunchGFExperienceUpdateInstall" name="${{InstallLocation}}\${{LaunchGFExperienceExeName}}" dir="${{InstallLocation}}" condition="SelfUpdateInstall &amp;&amp; LaunchGFExperience">
			<arg value="-UpdateInitiated"/>
			<arg value="-showClientReleaseHighlight"/>
		</exe>
		<standard phase="setClientSetOnReboot" when="installClose" condition="LaunchGFExperienceOnNextBoot">
			<addRegistry keyName="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" valueName="NvGFExperience" type="REG_SZ" value="&quot;${{InstallLocation}}\${{LaunchGFExperienceExeName}}&quot; -shellexecute -UpdateInitiated -showClientReleaseHighlight"/>
		</standard>
		<standard phase="deleteClientSetOnReboot" when="uninstall" onError="ignore">
			<deleteRegistry keyName="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" valueName="NvGFExperience"/>
		</standard>
		<custom phase="CloseSteam" action="CloseSteam" onError="ignore" when="uninstall" progress="500" autoTick="200" condition="CloseSteam"/>
		<custom phase="closeClient" action="CloseClient" onError="ignore" when="uninstall" progress="500" autoTick="200"/>
	</phases>
	<finishOptions>
		<option name="CreateDesktopShortcut" text="${{CreateDesktopShortcut}}" property="CreateDesktopShortcut" condition="DecideCreateDesktopShortcut"/>
		<option name="LaunchGFExperience" text="${{LaunchGFExperience}}" property="LaunchGFExperience" condition="DecideLaunchGFExperience"/>
	</finishOptions>
