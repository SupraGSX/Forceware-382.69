			<addRegistry keyName="${{GFExperienceGlobalRegKey}}" valueName="Installed" type="REG_DWORD" value="1"/>
			<addRegistry keyName="${{GFExperienceGlobalRegKey}}" valueName="Version" type="REG_SZ" value="${{ProductVersion}}"/>
			<addRegistry keyName="${{NvidiaSoftwareKey}}\Global\GFEClient" valueName="FullPath" type="REG_SZ" value="${{GeForceExperienceX86Path}}\${{LaunchGFExperienceExeName}}"/>
			<addRegistry keyName="${{NvidiaSoftwareKey}}\Global\GFEClient" valueName="Installed" type="REG_DWORD" value="1"/>
