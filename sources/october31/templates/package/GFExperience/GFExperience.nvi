		<if filter="minVista">
			<standard phase="copyx86OnlySpecificBinaries" platform="x86only">
				<copyFile target="${{UpdateCorePath}}\NvGFTrayPlugin.dll" source="NvGFTrayPlugin32.dll"/>
				<copyFile target="${{UpdateCorePath}}\NvGFTrayPluginr.dll" source="NvGFTrayPluginr32.dll"/>
			</standard>
